# Template only. Supply real settings in your host's runtime configuration.
GUARDCART_ENVIRONMENT=production
GUARDCART_ALLOWED_ORIGINS=https://guardcart.example.com
GUARDCART_ALLOWED_HOSTS=guardcart.example.com
GUARDCART_SECURE_COOKIES=true
GUARDCART_DATABASE_PATH=/data/guardcart.sqlite3
PORT=8000
# Start manual-only; enable AI deliberately after checking deployment and quotas.
GUARDCART_AI_ENABLED=false
GUARDCART_AI_BASE_URL=https://zendigikey.shop/v1
GUARDCART_AI_MODEL=gpt-6-luna
GUARDCART_AI_GLOBAL_CALL_LIMIT=200
GUARDCART_AI_SESSION_CALL_LIMIT=40
# Inject either a runtime key or a mounted key file; never both.
# GUARDCART_AI_API_KEY=
# GUARDCART_AI_API_KEY_FILE=/run/secrets/guardcart_ai_key
