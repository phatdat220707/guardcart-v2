# Copy this file to .env and edit locally. Never commit the real key.
GUARDCART_AI_BASE_URL=https://zendigikey.shop/v1
GUARDCART_AI_API_KEY=
# Gateway-advertised model ID; availability must be verified on your account.
GUARDCART_AI_MODEL=gpt-6-luna
# Optional: set false for manual-only development. Otherwise a configured key enables AI.
# GUARDCART_AI_ENABLED=false
# Hosting can instead mount a single-line key file:
# GUARDCART_AI_API_KEY_FILE=/run/secrets/guardcart_ai_key
# Configure either API_KEY or API_KEY_FILE; do not put a key in this example.
# Request quotas persist in the app database; these are NOT verified USD spending caps.
GUARDCART_AI_GLOBAL_CALL_LIMIT=200
GUARDCART_AI_SESSION_CALL_LIMIT=40
GUARDCART_AI_MAX_OUTPUT_TOKENS=768

